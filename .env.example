# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL (usuario service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Shared JWT secret (usuario + agendador-tarefas). Use a long random string.
JWT_SECRET=

# SMTP account used by the notificacao service to send reminders
MAIL_USERNAME=
MAIL_PASSWORD=

# Account the BFF reminder job logs in with
JOB_USER_EMAIL=
JOB_USER_PASSWORD=
