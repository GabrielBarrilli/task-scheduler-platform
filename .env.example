# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL (usuario service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Shared JWT secret (usuario + agendador-tarefas), Base64, at least 32 bytes.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Shared key the BFF reminder job uses on agendador-tarefas /internal routes.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
